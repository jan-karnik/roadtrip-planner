# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# database (local SQLite)
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/
# pre-deploy DB snapshots written by deploy/redeploy.sh (pruned there, keep the
# newest few) + one-off forensic copies. Never commit prod data.
prisma/dev.db.bak-*
prisma/dev.db.forensic-*

# env (holds Mapbox secret token — keep out of git; see .env.example)
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel
*.tsbuildinfo
