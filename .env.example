# Copy to `.env` and fill in. `.env` is gitignored — never commit real tokens.

# Local SQLite database file.
DATABASE_URL="file:./dev.db"

# Nominatim requires a descriptive User-Agent identifying the app + contact.
NOMINATIM_USER_AGENT="roadtrip-planner/0.1 (you@example.com)"

# Mapbox SECRET token (sk.) — server-side only, never sent to the browser.
# Used for Directions (road routes). Unset = straight-line legs with estimated times.
MAPBOX_API_KEY="sk...."

# Mapbox PUBLIC token (pk.) — exposed to the browser for the GL JS basemap.
NEXT_PUBLIC_MAPBOX_TOKEN="pk...."

# Single shared login. Unset in development = demo / demo. In production all
# three are REQUIRED (login is refused otherwise). AUTH_SESSION_TOKEN is the
# secret that signs session cookies (it is never sent to the browser); changing
# it logs everyone out. Generate with: openssl rand -hex 32
AUTH_USERNAME=""
AUTH_PASSWORD=""
AUTH_SESSION_TOKEN=""
